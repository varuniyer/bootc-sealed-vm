{
	email {$ACME_EMAIL}
	admin off
	persist_config off
	# caddy.socket passes Caddy the port 80 socket as fd/3 and the port 443 socket as fd/4, and every site
	# binds one of them. The last site below issues the redirects to HTTPS, on fd/3.
	auto_https disable_redirects
	servers {
		protocols h1
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "0"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

(precompressed_file_server) {
	file_server {
		precompressed br gzip
	}
}

{$DOMAIN} {
	bind fd/4
	import security_headers

	root * /usr/share/site

	@immutable_files path *.webp *.css *.js
	header @immutable_files Cache-Control "public, max-age=31536000, immutable"
	header Content-Security-Policy "default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none';"

	import precompressed_file_server

	handle_errors 404 {
		rewrite * /404.html
		import precompressed_file_server
	}
}

{$WEBSITE_ALIAS_DOMAINS} {
	bind fd/4
	redir https://{$DOMAIN}{uri} permanent
}

mta-sts.{$DOMAIN} {
	bind fd/4
	import security_headers
	root * /run/caddy/mta-sts
	file_server
}

# Stalwart answers Let's Encrypt's HTTP-01 challenges for its own certificate on mail.{$DOMAIN}. An
# http:// address keeps Caddy from requesting a certificate for that name.
http://mail.{$DOMAIN} {
	bind fd/3
	handle /.well-known/acme-challenge/* {
		reverse_proxy 127.0.0.1:9000
	}
	respond 404
}

http:// {
	bind fd/3
	redir https://{host}{uri} 308
}
