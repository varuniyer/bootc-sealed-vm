[Unit]
Description=Boot configuration from Parameter Store
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=pghash
ExecStart=/opt/scripts/boot-configuration.sh
RemainAfterExit=yes
RuntimeDirectory=boot-postgresql
RuntimeDirectoryMode=0750
# The secret store, which holds the secrets each boot stores from pending-secrets (see
# boot-configuration.sh).
StateDirectory=boot-configuration
StateDirectoryMode=0700

IPAddressAllow=any
ReadWritePaths=/run/caddy /run/stalwart /etc/pki/containers
NoExecPaths=/run/boot-postgresql /run/caddy /run/stalwart /etc/pki/containers
