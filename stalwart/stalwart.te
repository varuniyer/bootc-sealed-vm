policy_module(stalwart, 1.0.0)

type stalwart_t;
type stalwart_exec_t;
init_daemon_domain(stalwart_t, stalwart_exec_t)
# service-restrictions.conf sets NoNewPrivileges, under which systemd enters a domain only with
# nnp_transition.
init_nnp_daemon_domain(stalwart_t)

type stalwart_etc_t;
files_config_file(stalwart_etc_t)

# /var/lib/stalwart holds the RocksDB store: mail, calendars, contacts, certificates, and settings.
type stalwart_var_lib_t;
files_type(stalwart_var_lib_t)

# boot-configuration.sh copies the DKIM key, the Web Push key, and the relay password to
# /run/stalwart, and stalwart_t reads files of this type.
type stalwart_runtime_t;
files_pid_file(stalwart_runtime_t)

allow stalwart_t self:capability net_bind_service;
allow stalwart_t self:tcp_socket create_stream_socket_perms;
allow stalwart_t self:udp_socket create_socket_perms;

list_dirs_pattern(stalwart_t, stalwart_etc_t, stalwart_etc_t)
read_files_pattern(stalwart_t, stalwart_etc_t, stalwart_etc_t)
files_search_var_lib(stalwart_t)
manage_dirs_pattern(stalwart_t, stalwart_var_lib_t, stalwart_var_lib_t)
manage_files_pattern(stalwart_t, stalwart_var_lib_t, stalwart_var_lib_t)
# RocksDB checks the free space on /var's filesystem.
fs_getattr_xattr_fs(stalwart_t)
files_search_pids(stalwart_t)
list_dirs_pattern(stalwart_t, stalwart_runtime_t, stalwart_runtime_t)
read_files_pattern(stalwart_t, stalwart_runtime_t, stalwart_runtime_t)
# The spam filter's rule set is in /usr/share/stalwart.
files_read_usr_files(stalwart_t)
miscfiles_read_generic_certs(stalwart_t)

corenet_tcp_bind_generic_node(stalwart_t)
# Inbound SMTP on 25 and submission on 587, IMAP on 143, and HTTP on 9000.
corenet_tcp_bind_smtp_port(stalwart_t)
corenet_tcp_bind_pop_port(stalwart_t)
corenet_tcp_bind_http_port(stalwart_t)
# Forward Email's relay listens on 465, an SMTP port. ACME, the spam filter's lookup lists, the
# IP-to-ASN data, and Web Push deliveries reach HTTPS servers.
corenet_tcp_connect_smtp_port(stalwart_t)
corenet_tcp_connect_http_port(stalwart_t)
sysnet_dns_name_resolve(stalwart_t)
# The DNS resolver binds a random UDP source port for each query, as named and unbound do.
corenet_udp_bind_generic_node(stalwart_t)
corenet_udp_bind_all_unreserved_ports(stalwart_t)

kernel_read_net_sysctls(stalwart_t)
kernel_read_system_state(stalwart_t)
dev_read_sysfs(stalwart_t)
dev_read_urand(stalwart_t)
fs_read_cgroup_files(stalwart_t)
