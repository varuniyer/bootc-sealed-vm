# Red Hat's CDN admits dnf by the subscription's entitlement certificate, which each dnf step mounts
# under /run/secrets for its own run only. dnf checks every package against Red Hat's release key.
[rhel-10-for-$basearch-baseos-rpms]
name = Red Hat Enterprise Linux 10 for $basearch - BaseOS
baseurl = https://cdn.redhat.com/content/dist/rhel10/$releasever/$basearch/baseos/os
enabled = 1
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
sslcacert = /etc/rhsm/ca/redhat-uep.pem
sslclientcert = /run/secrets/entitlement_certificate
sslclientkey = /run/secrets/entitlement_key

[rhel-10-for-$basearch-appstream-rpms]
name = Red Hat Enterprise Linux 10 for $basearch - AppStream
baseurl = https://cdn.redhat.com/content/dist/rhel10/$releasever/$basearch/appstream/os
enabled = 1
gpgcheck = 1
gpgkey = file:///etc/pki/rpm-gpg/RPM-GPG-KEY-redhat-release
sslcacert = /etc/rhsm/ca/redhat-uep.pem
sslclientcert = /run/secrets/entitlement_certificate
sslclientkey = /run/secrets/entitlement_key
