[Unit]
Description=Root-side boot configuration from Parameter Store
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=pghash
ExecStart=/opt/scripts/boot-root.sh
RemainAfterExit=yes
RuntimeDirectory=boot-postgresql
RuntimeDirectoryMode=0750
# The secret store, which holds what the inbox delivers (see boot-root.sh).
StateDirectory=boot-root
StateDirectoryMode=0700

IPAddressAllow=any
ReadWritePaths=/run/caddy /run/stalwart /etc/pki/containers
NoExecPaths=/run/boot-postgresql /run/caddy /run/stalwart /etc/pki/containers
